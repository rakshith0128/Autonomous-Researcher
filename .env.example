# ---------------------------------------------------------------------------
# All services below have permanent free tiers and require no credit card.
# The system runs with as few as ONE llm key set, but more keys = more
# resilience, because the router fails over between providers mid-run.
# ---------------------------------------------------------------------------

# --- LLM providers (at least one required) ---------------------------------
# https://console.groq.com/keys        — fastest, primary
GROQ_API_KEY=
# https://aistudio.google.com/apikey   — largest free daily quota, secondary
GEMINI_API_KEY=
# https://cloud.cerebras.ai            — optional third failover
CEREBRAS_API_KEY=
# https://openrouter.ai/keys           — optional last-resort failover
OPENROUTER_API_KEY=

# --- Real-time search (required by the Domain Scout) -----------------------
# https://app.tavily.com               — 1000 credits/month free
TAVILY_API_KEY=

# --- Optional: raises GitHub API rate limit from 60/hr to 5000/hr ----------
# A classic PAT with NO scopes selected is sufficient (public data only).
GITHUB_TOKEN=

# --- Politeness (strongly recommended) --------------------------------------
# OpenAlex meters ANONYMOUS clients on a small daily budget -- exhausting it
# returns "Insufficient budget ... resets at midnight UTC" and the circuit
# breaker drops OpenAlex for the rest of the day. Supplying a contact address
# moves requests into the polite pool, which has a far larger allowance.
# Any real address works; it is sent only in the User-Agent header.
CONTACT_EMAIL=

# --- Runtime tuning --------------------------------------------------------
MAX_CYCLES=5
CONFIDENCE_ABSTAIN_THRESHOLD=0.60
MAX_CONCURRENT_RUNS=1
RUN_TIMEOUT_SECONDS=900
DATA_DIR=./data
LOG_LEVEL=INFO
