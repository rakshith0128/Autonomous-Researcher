# Build context hygiene: everything here either bloats the image, breaks the
# build, or leaks secrets into a layer.

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Rebuilt inside the image
frontend/node_modules/
frontend/dist/

# Secrets never enter the build context
.env
.env.local

# Runtime artefacts
data/
runs/
*.db
*.sqlite3
.chroma/

docs/
*.md
!README.md
